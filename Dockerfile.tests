# Dedicated disposable test image; no production secrets or data.
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTEST_DISABLE_PLUGIN_AUTOLOAD=1
WORKDIR /work
COPY requirements.txt requirements-dev.txt ./
RUN pip install --no-cache-dir -r requirements-dev.txt && useradd --system --uid 10001 tester
USER tester
CMD ["python", "-m", "pytest", "-q"]

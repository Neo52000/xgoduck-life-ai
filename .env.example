# Copier en .env et remplacer les deux valeurs REPLACE_WITH_...
ADMIN_USER=admin
ADMIN_PASSWORD=REPLACE_WITH_LONG_RANDOM_ADMIN_PASSWORD
ROBOT_API_KEY=REPLACE_WITH_LONG_RANDOM_ROBOT_SECRET

# Pour Docker compose : PostgreSQL + pgvector. Choisir un secret différent.
DB_PASSWORD=REPLACE_WITH_LONG_RANDOM_DATABASE_PASSWORD

# Optionnel : l'API OpenAI est facturée séparément ; aucune clé n'est incluse.
OPENAI_API_KEY=
VISION_MODEL=gpt-4.1-mini
# false par défaut : ne transmet jamais les exemples visuels mémorisés à l’IA externe.
REMOTE_REFERENCE_MATCHING=false
MAX_REFERENCE_IMAGES=8
# false = aucune photo envoyée automatiquement à l'IA externe
AUTO_VISION=false
MAX_AI_CALLS_PER_DAY=20
ALLOW_WIKIPEDIA=true
# Chaque cycle manuel recherche au maximum deux sujets et produit uniquement des brouillons.
MAX_RESEARCH_PER_CYCLE=2
# Pour le déploiement HTTPS avec Caddy, renseigner un domaine DNS pointant sur le VPS.
LIFEAI_DOMAIN=lifeai.exemple.fr

# V3 : optional developer-agent only; keep disabled until you explicitly run
# tools/create_candidate.py on a separate development machine.
DEV_OPENAI_API_KEY=
DEV_MODEL=gpt-4.1-mini

# V3.3 : renseigner le SHA du commit pour comparer les révisions sur un jeu fixe.
LIFEAI_CODE_REVISION=lifeai-3.3.0
